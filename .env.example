# The console calls the API same-origin at /api and Next.js proxies it to the backend
# (see next.config.ts). Point this at wherever the backend runs.
BACKEND_ORIGIN=http://localhost:8080

# Client-side API base. Leave as /api to use the proxy above.
NEXT_PUBLIC_API_BASE=/api

# Mapbox public token (pk....) for the map picker and geocoding search.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: Google Places API (New) key for exact-place search (shops, buildings), same as the app.
# Blank = free OpenStreetMap (Photon) search. Restrict the key to your console origin.
NEXT_PUBLIC_GOOGLE_PLACES_KEY=
