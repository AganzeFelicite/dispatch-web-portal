# Seeded as .env next to compose.yaml on each server. Never overwritten by CI or Ansible.

# `:dev` and `:prod` are moving tags pushed by CI; swap in a commit sha to roll back.
CONSOLE_IMAGE=ghcr.io/aganzefelicite/dispatch-web-portal:dev
# Address to listen on. Prod: leave unset (localhost, nginx in front). Dev: the Tailscale IP.
CONSOLE_BIND=
